################################################################################
# Combinations C(n,k) solution
# STUDENT NAME GOES HERE
################################################################################
# RENN LE
################################################################################
# register usage
# STUDENTS MUST EXPLAIN ALL REGISTERS THEY USE AND FOR WHAT PURPOSE HERE
################################################################################
# r0  <- 0 (always 0)
# r1  <- n (user input)
# r2  <- k (user input)
# r3  <- n - k
# r4  <- n! result
# r5  <- k! result
# r6  <- (n - k)! result
# r7  <- k! * (n - k)! (denominator)
# r8  <- C(n, k) final result
# r9  <- argument x for factorial function
# r10 <- factorial loop counter
# r11 <- constant 1
# r12 <- error value / temporary
# r13 <- Function return value (HMMM convention)
# r14 <- Function return address (HMMM convention)
# r15 <- Stack pointer (HMMM convention)

################################################################################
# Section: Input and Validation
################################################################################
# initialize stack pointer r15 to line 60
0  setn  r15 60
# read input n into r1
1  read  r1
# read input k into r2
2  read  r2
# if n < 0, jump to error handling at line 31
3  jltzn r1 31
# if n == 0, jump to error handling at line 31
4  jeqzn r1 31
# if k < 0, jump to error handling at line 31
5  jltzn r2 31
# if k == 0, jump to error handling at line 31
6  jeqzn r2 31

################################################################################
# Section: Function Call Prep
################################################################################
# pass argument x = n in r9
7  copy  r9 r1
# call factorial(n), return address in r14
8  calln r14 21
# store result n! into r4
9  copy  r4 r13
# pass argument x = k in r9
10 copy  r9 r2
# call factorial(k), return address in r14
11 calln r14 21
# store result k! into r5
12 copy  r5 r13
# r3 = n - k
13 sub   r3 r1 r2
# pass argument x = (n - k) in r9
14 copy  r9 r3
# call factorial(n - k), return address in r14
15 calln r14 21
# store result (n - k)! into r6
16 copy  r6 r13

################################################################################
# Section: Final Calc
################################################################################
# multiply k! and (n - k)! to get denominator in r7
17 mul   r7 r5 r6
# divide n! by denominator to get result C(n, k) in r8
18 div   r8 r4 r7
# write out final combination result
19 write r8
# halt normal program execution
20 halt

################################################################################
# Section: Factorial Function
# Input:  r9 (x)
# Output: r13 (x!)
################################################################################
# push return address r14 onto stack r15
21 pushr r14 r15
# initialize return value r13 = 1
22 setn  r13 1
# initialize constant 1 in r11
23 setn  r11 1
# copy argument x from r9 into loop counter r10
24 copy  r10 r9
# if counter == 0, exit loop to line 29
25 jeqzn r10 29
# multiply: r13 = r13 * r10
26 mul   r13 r13 r10
# decrement counter: r10 = r10 - 1
27 sub   r10 r10 r11
# loop back to line 25
28 jumpn 25
# pop return address r14 from stack r15
29 popr  r14 r15
# return to caller address in r14
30 jumpr r14

################################################################################
# Section: Error Handling
################################################################################
# load error code -1 into r12
31 setn  r12 -1
# print error code -1
32 write r12
# terminate program due to invalid input
33 halt
